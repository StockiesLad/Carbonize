    {
      "apply": [
        {
          "model": "carbonize:block/smoldering_stack",
          "y": 0
        },
        {
          "model": "carbonize:block/smoldering_stack",
          "y": 90
        },
        {
          "model": "carbonize:block/smoldering_stack",
          "y": 180
        },
        {
          "model": "carbonize:block/smoldering_stack",
          "y": 270
        }
      ],
      "when": {
        "stage": "smoldering"
      }
    },
    {
      "apply": [
        {
          "model": "carbonize:block/ember_stack",
          "y": 0
        },
        {
          "model": "carbonize:block/ember_stack",
          "y": 90
        },
        {
