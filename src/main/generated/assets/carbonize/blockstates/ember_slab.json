        "AND": [
          {
            "type": "top"
          },
          {
            "stage": "smoldering"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "carbonize:block/smoldering_planks"
      },
      "when": {
        "AND": [
          {
            "type": "double"
          },
          {
            "stage": "smoldering"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "carbonize:block/ember_slab"
