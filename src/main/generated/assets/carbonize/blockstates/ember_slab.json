{
  "multipart": [
    {
      "apply": {
        "model": "carbonize:block/smoldering_slab"
      },
      "when": {
        "AND": [
          {
            "type": "bottom"
          },
          {
            "stage": "smoldering"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "carbonize:block/smoldering_slab_top"
      },
